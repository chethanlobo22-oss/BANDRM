# ── RHYTHM MATES – Environment Variables ──────────────────────────────────────
# Copy this file to .env.local for local development.
# In production, add these in your Vercel project dashboard → Settings → Environment Variables.
# NEVER commit .env.local or any file with real credentials to git.

# The ID of your Google Spreadsheet.
# Found in the URL: https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your-spreadsheet-id-here

# The email address of your Google Service Account.
# Format: name@your-project.iam.gserviceaccount.com
GOOGLE_SA_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# The private key from your Service Account JSON key file.
# Copy the entire "private_key" value including the -----BEGIN/END----- lines.
# In Vercel dashboard, paste it exactly as-is (Vercel handles \n escaping).
GOOGLE_SA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
